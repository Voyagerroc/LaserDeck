<?xml version="1.0" encoding="utf-8"?>
<!--
  Spinner'a kendi zeminimizi verince Android'in varsayılan açılır ok simgesi
  de gidiyor ve alan sıradan bir kutuya benziyor. Ok burada geri konuyor.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/alan" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/cizgi" />
        </shape>
    </item>
    <item
        android:gravity="end|center_vertical"
        android:end="14dp"
        android:drawable="@drawable/ic_chevron"
        android:width="14dp"
        android:height="14dp" />
</layer-list>
